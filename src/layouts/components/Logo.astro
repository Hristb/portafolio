---
import config from "@/config/config.json";

const { title, base_path }: { title: string; base_path: string } = config.site;
const basePath = base_path || "/";
---

<a
  href={basePath}
  class="navbar-brand inline-flex flex-col items-start"
  aria-label={title}
  style="text-decoration:none;"
>
  <span
    class="logo-name font-secondary"
    style="
      font-size: 17px;
      font-weight: 700;
      letter-spacing: -0.01em;
      white-space: nowrap;
      line-height: 1;
      color: var(--ink-dark);
      transition: color 0.2s;
    "
  >
    Hrist Bartra
  </span>
  <span class="logo-tagline lg:hidden">
    Tecnología. Ideas. Construcción continua.
  </span>
</a>

<style>
  .navbar-brand:hover .logo-name {
    color: var(--accent);
  }

  .navbar-brand {
    min-width: 0;
    max-width: 100%;
  }

  .logo-tagline {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 10.5px;
    line-height: 1.3;
    margin-top: 3px;
    color: var(--ink-light);
    white-space: nowrap;
  }
</style>

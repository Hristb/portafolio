---
import ImageMod from "./ImageMod.astro";
import ProfileLinks from "@/partials/ProfileLinks.astro";

const stats = [
  {
    icon: "code",
    value: "+6 años",
    label: "construyendo software",
  },
  {
    icon: "briefcase",
    value: "4 empresas",
    label: "fintech, telecom, retail",
  },
  {
    icon: "layers",
    value: "Backend → Frontend",
    label: "me muevo según el proyecto",
  },
  {
    icon: "spark",
    value: "Aprendizaje continuo",
    label: "hoy, con IA",
  },
];

const ICONS: Record<string, string> = {
  code: `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
  briefcase: `<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>`,
  layers: `<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>`,
  spark: `<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>`,
};
---

<div class="hero-intro">
  <ImageMod
    src="/images/hrist-perfil.jpg"
    alt="Hrist Bartra"
    width={400}
    height={400}
    format="webp"
    class="hero-photo"
  />

  <h1 class="font-secondary hero-name">Hrist Bartra</h1>

  <p class="hero-summary">
    Construyo software y sigo aprendiendo en el camino — hoy, apoyado en IA
    para moverme más rápido entre problemas nuevos.
  </p>

  <ProfileLinks class="hero-links" location="home_hero" />

  <div class="hero-stats">
    {
      stats.map((s) => (
        <div class="hero-stat">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={ICONS[s.icon]}
          />
          <div>
            <p class="hero-stat-value">{s.value}</p>
            <p class="hero-stat-label">{s.label}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .hero-intro {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  /* :global — ImageMod renders the <img>/<Image> in its own file, so
     this component's scoped styles never reach it otherwise */
  :global(.hero-photo) {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    margin: 0 auto 22px;
    border: 1px solid var(--edge);
  }

  .hero-name {
    font-size: clamp(2.1rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--ink-dark);
    margin: 0 0 12px;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .hero-summary {
    font-size: clamp(15px, 2vw, 17px);
    color: var(--ink-light);
    max-width: 460px;
    margin: 0 auto 28px;
    line-height: 1.65;
  }

  :global(.hero-links) {
    justify-content: center;
    margin-bottom: 44px;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px 16px;
    padding-top: 28px;
    border-top: 1px solid var(--edge);
    text-align: left;
  }

  .hero-stat {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: var(--ink-light);
  }

  .hero-stat-value {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--ink-dark);
    margin: 0 0 2px;
    line-height: 1.3;
  }

  .hero-stat-label {
    font-size: 12px;
    color: var(--ink-light);
    margin: 0;
    line-height: 1.35;
  }

  @media (max-width: 640px) {
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

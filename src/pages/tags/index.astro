---
import Base from "@/layouts/Base.astro";
import { getAllTaxonomy, getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize } from "@/lib/utils/textConverter";
import PageHeader from "@/partials/PageHeader.astro";

const BLOG_FOLDER = "blog";

const tags = await getTaxonomy(BLOG_FOLDER, "tags");
const allTags = await getAllTaxonomy(BLOG_FOLDER, "tags");
---

<Base title={"Etiquetas"}>
  <PageHeader title={"Etiquetas"} />
  <section class="section">
    <div class="container">
      <ul class="tag-chip-list mx-auto max-w-[720px] justify-center">
        {
          tags.map((tag: any) => {
            const count = allTags.filter((c) => c === tag).length;
            return (
              <li>
                <a class="tag-chip" href={`/tags/${tag}`}>
                  {humanize(tag)} <span class="taxonomy-count">{count}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</Base>

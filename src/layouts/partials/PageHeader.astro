---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { humanize } from "@/lib/utils/textConverter";

const {
  title = "",
  compact = false,
}: { title?: string; compact?: boolean } = Astro.props;
---

<section>
  <div class="container text-center">
    <div
      class:list={[
        "rounded-2xl bg-gradient-to-b from-body to-light dark:from-darkmode-body dark:to-darkmode-light",
        compact ? "px-8 py-6" : "px-8 py-14",
      ]}
    >
      <h1 set:text={humanize(title)} />
      <Breadcrumbs className={compact ? "mt-2" : "mt-6"} />
    </div>
  </div>
</section>

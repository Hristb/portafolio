---
import { humanize } from "@/lib/utils/textConverter";

const { tags, categories, allCategories } = Astro.props;

const TAGS_LIMIT = 8;
const visibleTags = tags.slice(0, TAGS_LIMIT);
const hasMoreTags = tags.length > TAGS_LIMIT;
---

<div class="lg:col-4">
  <div class="lg:sticky lg:top-24">
    <!-- categories — hidden on mobile, where CategoryQuickNav already
         gives immediate access right under the page title -->
    <div class="mb-6 hidden lg:block">
      <h5 class="mb-3">Categorías</h5>
      <ul class="taxonomy-list">
        {
          categories.map((category: any) => {
            const count = allCategories.filter(
              (c: any) => c === category
            ).length;
            return (
              <li>
                <a class="taxonomy-row" href={`/categories/${category}`}>
                  <span>{humanize(category)}</span>
                  <span class="taxonomy-count">{count}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div class="sidebar-separator hidden lg:block" />

    <!-- tags -->
    <div>
      <h5 class="mb-3">Etiquetas</h5>
      <ul class="tag-chip-list">
        {
          visibleTags.map((tag: any) => (
            <li>
              <a class="tag-chip" href={`/tags/${tag}`}>
                {humanize(tag)}
              </a>
            </li>
          ))
        }
      </ul>
      {
        hasMoreTags && (
          <a href="/tags" class="see-all-tags">
            Ver todos los temas →
          </a>
        )
      }
    </div>
  </div>
</div>

<style>
  .sidebar-separator {
    height: 1px;
    background: var(--edge);
    margin: 1.5rem 0;
  }

  .see-all-tags {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }

  .see-all-tags:hover {
    text-decoration: underline;
  }
</style>

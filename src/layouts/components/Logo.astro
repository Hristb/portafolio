---
import config from "@/config/config.json";

const { title, base_path }: { title: string; base_path: string } = config.site;
const basePath = base_path || "/";
---

<a
  href={basePath}
  class="navbar-brand inline-flex items-center"
  aria-label={title}
  style="text-decoration:none;"
>
  <span
    style="
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.03em;
      white-space: nowrap;
      line-height: 1;
    "
  >
    <span style="color: rgba(124,58,237,0.55);">&lt;</span><!--
    --><span class="logo-name" style="color: inherit; transition: color 0.2s;">HB</span><!--
    --><span style="color: rgba(124,58,237,0.55);">&nbsp;/&gt;</span>
  </span>
</a>

<style>
  .navbar-brand:hover .logo-name {
    color: #7c3aed;
  }
  html.dark .logo-name {
    color: rgba(255,255,255,0.88);
  }
  html:not(.dark) .logo-name {
    color: #1a0a3c;
  }
</style>

---
import config from "@/config/config.json";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import ImageMod from "./ImageMod.astro";

const {
  summary_length,
  blog_folder,
}: { summary_length: number; blog_folder: string } = config.settings;
const { data } = Astro.props;
const { title, image, date, author, categories } = data.data;

// Falta imagen real → placeholder de trabajo (reemplazar luego por la
// imagen definitiva en /public/images/blog/<slug>.jpg, ver plantilla-articulo.md)
const cover = image || `https://placehold.co/800x500?text=${encodeURIComponent(slugify(title))}`;
---

<a href={`/${blog_folder}/${data.id}`} class="post-card block h-full">
  <div class="post-card-image-wrap">
    <ImageMod
      class="post-card-image"
      src={cover}
      alt={title}
      width={800}
      height={500}
      format="webp"
    />
  </div>

  <div class="post-card-body">
    {
      categories?.length > 0 && (
        <span class="post-card-category">{humanize(categories[0])}</span>
      )
    }
    <h3 class="post-card-title">{title}</h3>
    <p class="post-card-excerpt">
      {plainify(data.body?.slice(0, Number(summary_length)))}
    </p>
    <div class="post-card-meta">
      <span>{humanize(author)}</span>
      {date && <span>· {dateFormat(date)}</span>}
    </div>
  </div>
</a>

<style is:global>
  .post-card {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    border: 1px solid var(--edge);
    background: var(--surface);
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .post-card:hover {
    border-color: var(--ink-dark);
    transform: translateY(-3px);
  }

  .post-card-image-wrap {
    aspect-ratio: 8 / 5;
    overflow: hidden;
    background: var(--surface-alt);
  }
  .post-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 22px;
    flex: 1;
  }

  .post-card-category {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .post-card-title {
    font-size: 1.15rem;
    line-height: 1.35;
    color: var(--ink-dark);
    margin: 0;
  }

  .post-card-excerpt {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-light);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-meta {
    display: flex;
    gap: 6px;
    font-size: 12px;
    color: var(--ink-light);
    margin-top: auto;
    padding-top: 10px;
  }
</style>

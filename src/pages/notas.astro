---
import Base from "@/layouts/Base.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { TIPOS, FILTROS, type Tipo } from "@/lib/utils/notasTipos";
import { getCollection, render } from "astro:content";

const allNotas = (await getCollection("notas", ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const renderedNotas = await Promise.all(
  allNotas.map(async (nota) => {
    const { Content } = await render(nota);
    return { nota, Content };
  }),
);

// Agrupar por fecha
const grouped = new Map<string, typeof renderedNotas>();
for (const item of renderedNotas) {
  const label = dateFormat(item.nota.data.date, "d MMM yyyy");
  if (!grouped.has(label)) grouped.set(label, []);
  grouped.get(label)!.push(item);
}
const days = [...grouped.entries()];
---

<Base
  title="Cuaderno"
  meta_title="Cuaderno · Hrist Bartra"
  description="Lo que aprendo, leo y pienso día a día. Sin filtros, sin perfeccionar."
>
  <section class="section-sm">
    <div class="container">
      <div class="mx-auto max-w-2xl">

        <!-- Cabecera -->
        <div class="mb-10 border-b border-border pb-8">
          <p class="mb-1 text-sm font-medium uppercase tracking-widest text-primary">Cuaderno</p>
          <h1 class="h2 mb-3 text-text-dark dark:text-darkmode-text-dark">Lo que aprendo cada día</h1>
          <p class="text-text-light">
            No son artículos — son notas. Cosas que descubrí hoy, capítulos que leí, pensamientos
            sin terminar. Breve, honesto, en proceso.
          </p>
        </div>

        <!-- Filtros -->
        <div class="mb-8 flex flex-wrap gap-2" id="filtros" role="group" aria-label="Filtrar por tipo">
          {FILTROS.map((f, i) => (
            <button
              data-filtro={f.valor}
              class={`filtro-btn${i === 0 ? " active" : ""} rounded-full border border-border px-4 py-1.5 text-sm font-medium transition-colors hover:border-primary`}
            >
              {f.label}
            </button>
          ))}
        </div>

        <!-- Timeline agrupado por día -->
        <div id="timeline" class="space-y-8">
          {days.map(([dateLabel, notas]) => (
            <div
              class="day-group"
              data-tipos={notas.map((n) => n.nota.data.tipo).join(" ")}
            >
              <!-- Encabezado del día -->
              <div class="day-header mb-3 flex items-center gap-3">
                <span class="shrink-0 text-xs font-semibold uppercase tracking-widest text-primary">
                  {dateLabel}
                </span>
                <div class="h-px flex-1 bg-border" />
              </div>

              <!-- Filas acordeón -->
              <div class="day-rows space-y-1 pl-1">
                {notas.map(({ nota, Content }) => {
                  const t = TIPOS[nota.data.tipo as Tipo];
                  const id = `nota-${nota.id}`;
                  return (
                    <div class="nota-row" data-tipo={nota.data.tipo}>
                      <!-- Trigger row -->
                      <button
                        class={`row-trigger group w-full rounded-lg border border-transparent px-3 py-2.5 text-left transition-all hover:bg-light dark:hover:bg-darkmode-light ${t.rowAccentCls}`}
                        aria-expanded="false"
                        aria-controls={id}
                      >
                        <div class="flex items-center gap-2.5">
                          <span class="text-base leading-none">{t.emoji}</span>
                          <span class={`inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-xs font-semibold ${t.badgeCls}`}>
                            {t.label}
                          </span>
                          <span class="flex-1 text-sm font-medium leading-snug text-text-dark dark:text-darkmode-text-dark">
                            {nota.data.tema}
                          </span>
                          <span class="chevron shrink-0 text-xs text-text-light transition-transform duration-200">
                            ▶
                          </span>
                        </div>
                      </button>

                      <!-- Contenido expandible -->
                      <div
                        id={id}
                        class="row-content hidden overflow-hidden px-3 pb-1 pt-2"
                      >
                        <div class="cuaderno-prose border-l-2 border-border pl-4">
                          {nota.data.fuente && (
                            <p class="meta-fuente mb-2 text-xs italic">
                              📚 {nota.data.fuente}
                            </p>
                          )}
                          <Content />
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>

        <!-- Estado vacío -->
        <div id="sin-resultados" class="hidden py-12 text-center text-text-light">
          <p class="mb-3 text-4xl">📭</p>
          <p>Todavía no hay entradas de este tipo.</p>
        </div>

        <!-- Footer -->
        <p class="mt-12 text-center text-xs text-text-light opacity-60">
          Este cuaderno se actualiza cuando aprendo algo. Sin periodicidad fija.
        </p>

      </div>
    </div>
  </section>
</Base>

<style>
  .filtro-btn.active {
    border-color: var(--color-primary);
    background-color: var(--color-primary);
    color: white;
  }

  /* ── Metadata ───────────────────────────────────── */
  .meta-fuente {
    color: var(--color-text-light);
  }
  :global(.dark) .meta-fuente {
    color: var(--color-darkmode-text);
  }

  /* ── Prose content ───────────────────────────────── */
  .cuaderno-prose {
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--color-text);
  }
  :global(.dark) .cuaderno-prose {
    color: var(--color-darkmode-text-dark);
  }
  .cuaderno-prose :global(p) {
    margin-bottom: 0.5rem;
  }
  .cuaderno-prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .cuaderno-prose :global(strong) {
    font-weight: 600;
    color: var(--color-text-dark);
  }
  :global(.dark) .cuaderno-prose :global(strong) {
    color: var(--color-darkmode-text-dark);
  }
  .cuaderno-prose :global(em) {
    font-style: italic;
  }
  .cuaderno-prose :global(code) {
    border-radius: 0.25rem;
    background-color: var(--color-light);
    color: var(--color-primary);
    padding: 0.125rem 0.375rem;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
  }
  :global(.dark) .cuaderno-prose :global(code) {
    background-color: var(--color-darkmode-light);
    color: var(--color-darkmode-primary);
  }
  .cuaderno-prose :global(pre) {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
    overflow-x: auto;
    border-radius: 0.5rem;
    background-color: var(--color-light);
    padding: 0.75rem;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
  }
  :global(.dark) .cuaderno-prose :global(pre) {
    background-color: var(--color-darkmode-light);
  }
  .cuaderno-prose :global(pre code) {
    background-color: transparent;
    padding: 0;
    color: inherit;
  }
  .cuaderno-prose :global(ul) {
    margin-bottom: 0.5rem;
    list-style-type: disc;
    padding-left: 1.25rem;
  }
  .cuaderno-prose :global(ol) {
    margin-bottom: 0.5rem;
    list-style-type: decimal;
    padding-left: 1.25rem;
  }
  .cuaderno-prose :global(li) {
    margin-bottom: 0.25rem;
  }
  .cuaderno-prose :global(blockquote) {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    border-left: 2px solid var(--color-primary);
    padding-left: 0.75rem;
    font-style: italic;
    color: var(--color-text-light);
  }
  :global(.dark) .cuaderno-prose :global(blockquote) {
    border-left-color: var(--color-darkmode-primary);
    color: var(--color-darkmode-text);
  }
</style>

<script>
  // ── Acordeón ──────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>(".row-trigger").forEach((btn) => {
    btn.addEventListener("click", () => {
      const contentId = btn.getAttribute("aria-controls")!;
      const content = document.getElementById(contentId)!;
      const chevron = btn.querySelector<HTMLElement>(".chevron")!;
      const isOpen = btn.getAttribute("aria-expanded") === "true";

      btn.setAttribute("aria-expanded", String(!isOpen));
      content.classList.toggle("hidden", isOpen);
      chevron.style.transform = isOpen ? "" : "rotate(90deg)";
    });
  });

  // ── Filtros ────────────────────────────────────────────────
  const btns = document.querySelectorAll<HTMLButtonElement>(".filtro-btn");
  const rows = document.querySelectorAll<HTMLElement>(".nota-row");
  const groups = document.querySelectorAll<HTMLElement>(".day-group");
  const sinResultados = document.getElementById("sin-resultados");

  function actualizarVista(filtro: string) {
    let totalVisibles = 0;

    groups.forEach((group) => {
      let visiblesEnGrupo = 0;
      group.querySelectorAll<HTMLElement>(".nota-row").forEach((row) => {
        const mostrar = filtro === "todos" || row.dataset.tipo === filtro;
        row.hidden = !mostrar;
        if (mostrar) visiblesEnGrupo++;
      });
      group.hidden = visiblesEnGrupo === 0;
      totalVisibles += visiblesEnGrupo;
    });

    if (sinResultados) {
      sinResultados.classList.toggle("hidden", totalVisibles > 0);
    }
  }

  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      btns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      actualizarVista(btn.dataset.filtro ?? "todos");
    });
  });
</script>
